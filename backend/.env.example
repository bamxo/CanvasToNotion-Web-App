# ---------------------------------------------------------------------------
# Environment variables for the Vercel backend (backend/public Express app).
# Copy to `.env` for local dev; set the same keys in the Vercel project's
# Environment Variables (Production + Preview). Do NOT commit real values.
# ---------------------------------------------------------------------------

# --- Firebase Admin SDK (server) -------------------------------------------
# Full service-account JSON, on a SINGLE line. The app applies newline fixes
# for the private_key, so `\n`-escaped keys are fine. Replaces the old
# serviceAccountKey.json disk file.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com

# --- Firebase REST config (used by config/firebase.ts for REST auth calls) --
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Google OAuth (Google sign-in token verification) ---------------------
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Notion OAuth / integration -----------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://canvastonotion.io/notion/callback

# --- Contact form email (nodemailer, Gmail) ----------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Runtime -----------------------------------------------------------
NODE_ENV=production
# PORT is only used for local `npm run dev` / `npm start`; Vercel ignores it.
PORT=3000
